#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        pipe_mod_tilde: pipe_mod_tilde {
            compatible = "zmk,behavior-mod-morph";
            label = "PIPE_MOD_TILDE";
            bindings = <&kp GRAVE>, <&kp RA(RIGHT_BRACKET)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        multiply {
            bindings = <&kp PIPE>;
            key-positions = <42 56>;
        };

        add {
            bindings = <&kp MINUS>;
            key-positions = <41 55>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <30 31 32>;
        };

        delete {
            bindings = <&kp DELETE>;
            key-positions = <18 19>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&pipe_mod_tilde  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3   &kp NUMBER_4   &kp N5  &kp RA(N7)                                                      &kp RA(N0)  &kp NUMBER_6  &kp N7         &kp N8            &kp N9         &kp N0      &kp MINUS
&kp TAB          &kp Q         &kp W         &kp E          &kp R          &kp T   &kp RA(N8)                                                      &kp RA(N9)  &kp Y         &kp U          &kp I             &kp O          &kp P       &kp LEFT_BRACKET
&kp ESC          &kp A         &kp S         &kp D          &kp F          &kp G   &kp LS(N8)       &kp LCTRL  &kp LALT      &mo 2      &kp RCTRL  &kp LS(N9)  &kp H         &kp J          &kp K             &kp L          &kp SEMI    &kp SQT
&kp LSHFT        &kp Z         &kp X         &kp C          &kp V          &kp B                               &kp HOME      &kp PG_UP                         &kp N         &kp M          &kp COMMA         &kp DOT        &kp FSLH    &kp RSHFT
&kp RCTRL        &kp EQUAL     &kp LEFT_ALT  &kp BACKSLASH  &kp RA(LS(Z))          &lt 1 BACKSPACE  &kp SPACE  &kp LCMD      &kp PG_DN  &kp ENTER  &lt 1 ESC                 &kp RA(LS(X))  &kp LS(NUMBER_2)  &kp LS(EQUAL)  &kp LS(N7)  &kp PRINTSCREEN
            >;
        };

        fn {
            bindings = <
&trans  &kp F1            &kp F2            &kp F3            &kp F4            &kp F5      &trans                                      &trans  &kp F6          &kp F7    &kp F8        &kp F9     &kp F10                &kp F11
&trans  &trans            &trans            &trans            &trans            &trans      &trans                                      &trans  &trans          &trans    &trans        &trans     &kp LS(RIGHT_BRACKET)  &kp F12
&trans  &kp LS(NUMBER_1)  &kp RA(NUMBER_2)  &kp LS(NUMBER_3)  &kp RA(NUMBER_4)  &kp LS(N5)  &trans  &trans  &trans      &trans  &trans  &trans  &kp LEFT_ARROW  &kp DOWN  &kp UP_ARROW  &kp RIGHT  &kp PIPE               &trans
&trans  &trans            &trans            &trans            &trans            &trans                      &trans      &trans                  &kp HOME        &trans    &trans        &kp END    &trans                 &trans
&trans  &trans            &trans            &trans            &trans                        &trans  &trans  &trans      &trans  &trans  &trans                  &trans    &trans        &trans     &trans                 &trans
            >;
        };

        mod {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans                                           &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans        &bootloader                                      &bootloader  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans        &trans       &trans  &trans      &trans  &trans  &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans                             &trans      &trans                       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans                      &trans       &trans  &trans      &trans  &trans  &trans               &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
